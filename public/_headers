# Static Assets - Cache for 1 year (Immutable)
# Because we use query params for versioning (?v=hash), it is safe to cache aggressively.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML Files - Do not cache (Revalidate)
# Ensures users always get the latest version references
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers - 静态资源；Functions 响应由 _middleware.js 补齐
# HSTS 不启用 includeSubDomains，避免影响未启用 HTTPS 的自定义子域
# _headers 是静态配置，无法判断请求协议，所以这里统一下发；HTTP 响应里的
# HSTS 会被浏览器直接忽略，因此与 _middleware.js 里「仅 https 下发」等价
# X-Frame-Options 用 SAMEORIGIN：允许同域嵌入，拒绝第三方嵌入
# CSP 只声明 frame-ancestors，不设默认策略，避免影响内联脚本与样式
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
